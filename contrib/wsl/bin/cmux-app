#!/bin/sh
# WSLg용 cmux 실행 래퍼: 한글 입력(ibus) + d3d12 GL
export GTK_IM_MODULE=ibus QT_IM_MODULE=ibus XMODIFIERS=@im=ibus
export GALLIUM_DRIVER=d3d12
# notify-send shim (Windows toast) lives here; start-menu launches lack it on PATH
export PATH="$HOME/.local/bin:$PATH"
# ibus 연결이 안 되면 데몬을 띄움. -r(기존 데몬 대체)은 쓰지 않음: 이미 떠 있으면 새 데몬이 바로 종료됨
if [ -n "$WAYLAND_DISPLAY$DISPLAY" ] && ! ibus engine >/dev/null 2>&1; then
    ibus-daemon -dx >/dev/null 2>&1
    # ibus-memconf는 설정을 저장하지 않아 새 데몬은 영문 엔진으로 시작함 → 한글 엔진 지정
    # (Shift+Space 한/영 전환은 한글 엔진 안에서만 동작)
    for _ in 1 2 3 4 5; do ibus engine hangul >/dev/null 2>&1 && break; sleep 0.5; done
    sleep 1
fi
exec /usr/bin/cmux-app "$@"
